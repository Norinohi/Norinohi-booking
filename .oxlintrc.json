{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "jsPlugins": [{ "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error"
  },
  "env": {
    "builtin": true
  },
  "overrides": [
    {
      "files": ["packages/providers/src/shared/json-source.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off"
      }
    },
    {
      "files": [
        "packages/providers/src/shared/errors.ts",
        "packages/providers/src/shared/reservation-log.ts"
      ],
      "rules": {
        "anti-slop/no-known-value-widening": "off",
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    },
    {
      "files": ["packages/providers/src/shared/raw-retention.ts"],
      "rules": {
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      "files": [
        "packages/providers/src/sync/runner.ts",
        "packages/providers/src/sync/availability-writer.ts"
      ],
      "rules": {
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    },
    {
      "files": ["packages/providers/src/sync/cursor.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off"
      }
    },
    {
      "files": [
        "packages/api/src/context.ts",
        "packages/api/src/services/pg-errors.ts",
        "packages/providers/src/shared/retry.ts",
        "packages/providers/src/scripts/*.ts",
        "packages/providers/src/mapping/mock.ts",
        "packages/providers/src/booking-manager/catalogue.ts",
        "packages/providers/src/booking-manager/prices.ts",
        "packages/providers/src/booking-manager/provider.ts",
        "packages/providers/src/nausys/catalogue.ts",
        "packages/providers/src/nausys/occupancy.ts",
        "packages/providers/src/nausys/provider.ts"
      ],
      "rules": {
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    {
      "files": ["packages/ui/src/components/form/form.tsx"],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    }
  ]
}
