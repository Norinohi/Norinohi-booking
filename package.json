{
  "name": "my-better-t-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:push": "turbo run db:push -F @my-better-t-app/db",
    "db:studio": "turbo run db:studio -F @my-better-t-app/db",
    "db:generate": "turbo run db:generate -F @my-better-t-app/db",
    "db:migrate": "turbo run db:migrate -F @my-better-t-app/db",
    "db:start": "turbo run db:start -F @my-better-t-app/db",
    "db:watch": "turbo run db:watch -F @my-better-t-app/db",
    "db:stop": "turbo run db:stop -F @my-better-t-app/db",
    "db:down": "turbo run db:down -F @my-better-t-app/db",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@my-better-t-app/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@my-better-t-app/config": "workspace:*",
    "@types/node": "^22.13.14",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "turbo": "^2.10.2",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.31.0"
}
