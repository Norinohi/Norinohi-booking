{
  "name": "yacht-charter",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "storybook": "pnpm --filter @yacht-charter/ui storybook",
    "build-storybook": "pnpm --filter @yacht-charter/ui build-storybook",
    "db:push": "turbo run db:push -F @yacht-charter/db",
    "db:studio": "turbo run db:studio -F @yacht-charter/db",
    "db:generate": "turbo run db:generate -F @yacht-charter/db",
    "db:migrate": "turbo run db:migrate -F @yacht-charter/db",
    "db:start": "turbo run db:start -F @yacht-charter/db",
    "db:watch": "turbo run db:watch -F @yacht-charter/db",
    "db:stop": "turbo run db:stop -F @yacht-charter/db",
    "db:down": "turbo run db:down -F @yacht-charter/db",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@yacht-charter/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@yacht-charter/config": "workspace:*",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "turbo": "^2.10.5",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.31.0"
}
