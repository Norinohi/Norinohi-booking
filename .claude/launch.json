{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:web"],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:server"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@yacht-charter/ui", "storybook", "--no-open"],
      "port": 6006
    },
    {
      "name": "emails",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@yacht-charter/transactional", "dev"],
      "port": 3002
    }
  ]
}
