{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "migrate": "node dist/migrate.mjs",
    "start": "node dist/index.mjs",
    "sync:catalogue": "node dist/sync-catalogue.mjs",
    "sync:availability": "node dist/sync-availability.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@yacht-charter/api": "workspace:*",
    "@yacht-charter/auth": "workspace:*",
    "@yacht-charter/db": "workspace:*",
    "@yacht-charter/env": "workspace:*",
    "@yacht-charter/providers": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "evlog": "catalog:",
    "hono": "catalog:",
    "stripe": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@yacht-charter/config": "workspace:*",
    "tsdown": "^0.22.13",
    "tsx": "^4.22.4",
    "typescript": "catalog:"
  }
}
