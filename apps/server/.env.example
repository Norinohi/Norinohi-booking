# Server env — copy to `.env`. Schema: packages/env/src/server.ts
# drizzle.config.ts also reads DATABASE_URL from this file.
# Active vars are validated now; commented vars arrive in their milestone.

# --- Core (required now) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/yacht-charter
# DIRECT_URL=postgresql://...           # only if pooled Postgres (Neon/Supabase/pgBouncer); migrations use it
BETTER_AUTH_SECRET=dev-only-change-me-0123456789abcdefghijklmnop
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
# Leave unset locally: web (:3001) and server (:3000) share the `localhost`
# cookie host, since cookies ignore ports. Set it in any deployment where the
# web app and the API sit on different subdomains, otherwise better-auth writes
# a host-only session cookie the web host never receives.
# COOKIE_DOMAIN=.yachtskanner.com
OPENAPI_SERVER_URL=http://localhost:3000/api-reference
NODE_ENV=development
# APP_URL=http://localhost:3001         # web app public URL (email links, redirects)

# --- Providers (M2) ---
PROVIDER_MODE=mock                      # mock | booking_manager | nausys

# --- Social sign-in (optional pair; Google button is inert unless both are set) ---
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=

# --- Email (M4) ---
# Optional as a pair, like Stripe/Google above: without both, sendEmail() skips
# rather than the server failing to boot. EMAIL_FROM must be on a domain
# verified in Resend (or the sandbox onboarding@resend.dev in dev).
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@yourdomain.com     # dev: onboarding@resend.dev
# Where new enquiries and booking questions are announced. Unset skips the internal
# alert; the staff inbox at /inbox still lists everything.
# STAFF_EMAIL=crew@yourdomain.com

# --- Payments (M5, Stripe test mode) ---
# Optional as a pair. Without both, checkout.confirm returns NOT_IMPLEMENTED and
# /api/stripe/webhook is not mounted; the invoice and enquiry paths still work.
# Get the webhook secret from `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Security (M5) ---
# Base64 of 32 random bytes. Encrypts the identity-document fields on
# booking_traveller; without it booking.travellers.* returns NOT_IMPLEMENTED and
# everything else keeps working. Rotating it makes existing rows unreadable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ENCRYPTION_KEY=

# --- Observability (M6) ---
# SENTRY_DSN=https://xxx.ingest.sentry.io/xxx
# SENTRY_ENVIRONMENT=staging
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_AUTH_TOKEN=                    # build-time: upload source maps
# SENTRY_ORG=
# SENTRY_PROJECT=
# AXIOM_TOKEN=xaat-...                  # or the OTLP endpoint of your chosen evlog drain
# AXIOM_DATASET=yacht-charter
# POSTHOG_API_KEY=phc_...               # only if sending server-side analytics
# POSTHOG_HOST=https://us.i.posthog.com

# --- NauSYS connector (M4 transport; live from M9) ---
# Test host: https://ws-test.nausys.com — production: https://ws.nausys.com
# NAUSYS_BASE_URL=https://ws-test.nausys.com
# Optional as a pair. Without both, PROVIDER_MODE=nausys throws on construction
# and mock mode keeps working; the server still boots.
# NAUSYS_USERNAME=
# NAUSYS_PASSWORD=
# NAUSYS_TIMEOUT_MS=30000               # per HTTP attempt
# NAUSYS_MIN_INTERVAL_MS=250            # idle gap between two catalogue/availability
#                                       # sync calls on one credential. The vendor
#                                       # forbids parallel calls on that lane only;
#                                       # live booking-flow calls are exempt.
# NAUSYS_OPTION_SAFETY_MARGIN_MINUTES=15  # holdExpiresAt = optionTill − this margin
# NAUSYS_OPTION_TIMEZONE=Europe/Zagreb  # optionTill carries no zone (vendor question Q-OPT)

# --- Booking Manager connector (MMK) ---
# Contract: https://api.swaggerhub.com/apis/mmksystems/bm-api/2.1.4
# Beta host: http://beta.booking-manager.com/api/v2
# BOOKING_MANAGER_BASE_URL=https://www.booking-manager.com/api/v2
# A Bearer token, not an API key. Without it, PROVIDER_MODE=booking_manager
# throws on construction and mock mode keeps working; the server still boots.
# BOOKING_MANAGER_API_TOKEN=
# BOOKING_MANAGER_TIMEOUT_MS=30000      # per HTTP attempt
# BOOKING_MANAGER_MIN_INTERVAL_MS=250   # idle gap between calls on one credential;
#                                       # the vendor has not published a rate limit
# BOOKING_MANAGER_OPTION_SAFETY_MARGIN_MINUTES=15  # holdExpiresAt = expirationDate minus this
# BOOKING_MANAGER_TIMEZONE=Europe/Zagreb  # vendor confirmed fixed CET observing DST

# --- Live provider connectors (post-demo) ---
# CLOUDINARY_API_KEY=                   # only if caching/transforming provider media server-side
# CLOUDINARY_API_SECRET=
# REDIS_URL=redis://localhost:6379      # only if we add a sync queue / cache / rate limiting
# CRON_SECRET=                          # protects the scheduled maintenance endpoint
#                                       # POST /api/cron/sweep-expiries, Authorization: Bearer <secret>
#                                       # min 16 chars; unset means the route refuses every request

# --- Meta ---
# SKIP_ENV_VALIDATION=1                 # skip Zod validation (CI / scripts)

# Shared with the web app's /api/revalidate route. After a provider sync the server
# posts there so the cached catalog reads (docs/adr/0002) drop immediately instead of
# waiting out their window. Must match REVALIDATE_SECRET in the web app's env; unset
# simply skips the notification. Minimum 16 characters.
# REVALIDATE_SECRET=

# Provider codes whose listings publish as they import, comma separated. Without it a
# catalogue sync imports new yachts as drafts that never appear on the site, since a
# sync creates a listing once and only updates it afterwards. Per-provider
# `provider.config.autoPublish` overrides this and wins even when it says false.
# PROVIDER_AUTO_PUBLISH=nausys
