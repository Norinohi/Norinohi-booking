# Server env — copy to `.env`. Schema: packages/env/src/server.ts
# drizzle.config.ts also reads DATABASE_URL from this file.
# Active vars are validated now; commented vars arrive in their milestone.

# --- Core (required now) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/yacht-charter
# DIRECT_URL=postgresql://...           # only if pooled Postgres (Neon/Supabase/pgBouncer); migrations use it
BETTER_AUTH_SECRET=dev-only-change-me-0123456789abcdefghijklmnop
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
OPENAPI_SERVER_URL=http://localhost:3000/api-reference
NODE_ENV=development
# APP_URL=http://localhost:3001         # web app public URL (email links, redirects)

# --- Providers (M2) ---
PROVIDER_MODE=mock                      # mock | booking_manager | nausys

# --- Email (M4, only if auth email verification / reset is enabled) ---
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@yourdomain.com     # dev: onboarding@resend.dev

# --- Payments (M5, Stripe test mode) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Security (M5) ---
# ENCRYPTION_KEY=                       # 32-byte key to encrypt PII / crew data at rest

# --- Observability (M6) ---
# SENTRY_DSN=https://xxx.ingest.sentry.io/xxx
# SENTRY_ENVIRONMENT=staging
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_AUTH_TOKEN=                    # build-time: upload source maps
# SENTRY_ORG=
# SENTRY_PROJECT=
# AXIOM_TOKEN=xaat-...                  # or the OTLP endpoint of your chosen evlog drain
# AXIOM_DATASET=yacht-charter
# POSTHOG_API_KEY=phc_...               # only if sending server-side analytics
# POSTHOG_HOST=https://us.i.posthog.com

# --- Live provider connectors (post-demo) ---
# NAUSYS_API_URL=https://...
# NAUSYS_USERNAME=
# NAUSYS_PASSWORD=
# BOOKING_MANAGER_API_URL=https://...
# BOOKING_MANAGER_API_KEY=
# CLOUDINARY_API_KEY=                   # only if caching/transforming provider media server-side
# CLOUDINARY_API_SECRET=
# REDIS_URL=redis://localhost:6379      # only if we add a sync queue / cache / rate limiting
# CRON_SECRET=                          # protects the sync/reconciliation trigger endpoint

# --- Meta ---
# SKIP_ENV_VALIDATION=1                 # skip Zod validation (CI / scripts)
