# Server env — copy to `.env`. Schema: packages/env/src/server.ts
# drizzle.config.ts also reads DATABASE_URL from this file.

DATABASE_URL=postgresql://postgres:password@localhost:5432/yacht-charter
BETTER_AUTH_SECRET=dev-only-change-me-0123456789abcdefghijklmnop
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development

