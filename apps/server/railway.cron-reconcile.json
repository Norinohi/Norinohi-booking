{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=server...",
    "watchPatterns": [
      "apps/server/**",
      "packages/api/**",
      "packages/auth/**",
      "packages/config/**",
      "packages/db/**",
      "packages/env/**",
      "packages/providers/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "turbo.json",
      ".node-version"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter server reconcile:reservations",
    "cronSchedule": "17 */6 * * *",
    "multiRegionConfig": { "europe-west4-drams3a": { "numReplicas": 1 } },
    "restartPolicyType": "NEVER"
  }
}
