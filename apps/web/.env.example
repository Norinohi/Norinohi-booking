# Web app environment — copy to `.env.local` and fill in.
# Contract: packages/env/src/web.ts (Zod, validated at build/start time).

# Origin of the API server the web app calls (dev server runs on :3000).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# The web app's own public URL — base for metadata, canonical URLs and OG images.
# Defaults to http://localhost:3001 in dev; set the real origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Cloudinary cloud name for the shared <Image> component.
# `demo` is Cloudinary's public sandbox cloud (has the `sample` image) —
# replace with the project's real cloud name.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=demo

# Mapbox public access token for the map screens. Must be a `pk.` token —
# a secret `sk.` one would be shipped to the browser. Restrict it to the app's
# domains in the Mapbox account, since anything public is readable by visitors.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-token-here

# --- Payments (M5, Stripe publishable key) ---
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Scheduling widget ---
# Public scheduling link for the embedded Calendly widget (Event Type > Share tab).
# No API key needed for a pure embed.
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-org/consultation

# --- Observability (M6) ---
# NEXT_PUBLIC_SENTRY_DSN=https://xxx.ingest.sentry.io/xxx
# NEXT_PUBLIC_POSTHOG_KEY=phc_...            # only if using PostHog
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Shared with the API server, which posts to /api/revalidate after a provider sync to
# drop the cached catalog reads. Must match REVALIDATE_SECRET in apps/server/.env;
# unset makes the route refuse every request. Minimum 16 characters.
# REVALIDATE_SECRET=
