# Web app environment — copy to `.env.local` and fill in.
# Contract: packages/env/src/web.ts (Zod, validated at build/start time).

# Origin of the API server the web app calls (dev server runs on :3000).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# The web app's own public URL — base for metadata, canonical URLs and OG images.
# Defaults to http://localhost:3001 in dev; set the real origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Cloudinary cloud name for the shared <Image> component.
# `demo` is Cloudinary's public sandbox cloud (has the `sample` image) —
# replace with the project's real cloud name.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=demo

# Mapbox public access token for the map screens. Must be a `pk.` token —
# a secret `sk.` one would be shipped to the browser. Restrict it to the app's
# domains in the Mapbox account, since anything public is readable by visitors.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-token-here

# --- Payments (M5, Stripe publishable key) ---
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Scheduling widget ---
# Public scheduling link for the Calendly embed on /plan-my-trip/consultation
# (Event Type > Share tab). No API key needed for a pure embed. Optional — without
# it, the "book a call" option falls back to the send-a-message form.
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-org/consultation

# --- Observability (M6) ---
# Server side. The Next.js server runs its own evlog instance, separate from the Hono
# server's, so these are set here too and carry the same meaning as in
# apps/server/.env.example. Unset registers no drain.
# SENTRY_DSN=https://xxx.ingest.sentry.io/xxx
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com
# OBSERVABILITY_ENVIRONMENT=staging
# OBSERVABILITY_RELEASE=

# Browser side, for what never reaches our server: filter changes, gallery opens, an
# abandoned checkout step (src/lib/analytics.ts). A PostHog project key is publishable
# by design, which is why this is a separate variable from POSTHOG_API_KEY above rather
# than the same one re-exported. Unset makes `track()` a no-op.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
#
# Browser error tracking is NOT wired: it needs @sentry/nextjs and its build step,
# which is a separate decision from these drains. Server-side errors are covered.

# Shared with the API server, which posts to /api/revalidate after a provider sync to
# drop the cached catalog reads. Must match REVALIDATE_SECRET in apps/server/.env;
# unset makes the route refuse every request. Minimum 16 characters.
# REVALIDATE_SECRET=
