# Web app environment — copy to `.env.local` and fill in.
# Contract: packages/env/src/web.ts (Zod, validated at build/start time).

# Origin of the API server the web app calls (dev server runs on :3000).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudinary cloud name for the shared <Image> component.
# `demo` is Cloudinary's public sandbox cloud (has the `sample` image) —
# replace with the project's real cloud name.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=demo

# Mapbox public access token for the map screens. Must be a `pk.` token —
# a secret `sk.` one would be shipped to the browser. Restrict it to the app's
# domains in the Mapbox account, since anything public is readable by visitors.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-token-here
