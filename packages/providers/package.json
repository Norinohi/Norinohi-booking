{
  "name": "@yacht-charter/providers",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc -b --noEmit",
    "test": "vitest run",
    "import:nausys": "node --env-file-if-exists=../../apps/server/.env --import tsx src/scripts/import-nausys.ts",
    "import:booking-manager": "node --env-file-if-exists=../../apps/server/.env --import tsx src/scripts/import-booking-manager.ts",
    "import:booking-manager-yacht": "node --env-file-if-exists=../../apps/server/.env --import tsx src/scripts/import-booking-manager-yacht.ts",
    "prices:sync": "node --env-file-if-exists=../../apps/server/.env --import tsx src/scripts/sync-prices.ts",
    "listings:visibility": "node --env-file-if-exists=../../apps/server/.env --import tsx src/scripts/set-provider-visibility.ts",
    "listings:purge": "node --env-file-if-exists=../../apps/server/.env --import tsx src/scripts/purge-provider-data.ts",
    "probe:crewlist": "node --env-file-if-exists=../../apps/server/.env --import tsx src/scripts/probe-crewlist-link.ts",
    "probe:crew-list": "node --env-file-if-exists=../../apps/server/.env --import tsx src/scripts/probe-crew-list.ts",
    "facets:backfill": "node --env-file-if-exists=../../apps/server/.env --import tsx src/scripts/backfill-facet-translations.ts",
    "probe:booking-manager": "node --env-file-if-exists=../../apps/server/.env --import tsx src/scripts/probe-booking-manager.ts",
    "offers:backfill": "node --env-file-if-exists=../../apps/server/.env --import tsx src/scripts/backfill-listing-offers.ts",
    "offers:verify": "node --env-file-if-exists=../../apps/server/.env --import tsx src/scripts/verify-offers.ts",
    "catalogue:reproject": "node --env-file-if-exists=../../apps/server/.env --import tsx src/scripts/reproject-catalogue.ts"
  },
  "dependencies": {
    "@yacht-charter/db": "workspace:*",
    "@yacht-charter/env": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@yacht-charter/config": "workspace:*",
    "tsx": "^4.22.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
